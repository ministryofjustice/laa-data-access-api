# Copy this file to k6/.env and set the client secrets outside version control.
#
# These client IDs select deterministic identities from the local and shared mock OAuth servers.
# Do not commit k6/.env or client secrets.
K6_PROVIDER_CLIENT_ID=k6-provider
K6_PROVIDER_CLIENT_SECRET=
K6_APPLICATION_CASEWORKER_CLIENT_ID=k6-application-caseworker
K6_APPLICATION_CASEWORKER_CLIENT_SECRET=
K6_PA_CASEWORKER_CLIENT_ID=k6-pa-caseworker
K6_PA_CASEWORKER_CLIENT_SECRET=
K6_CONTENDER_CLIENT_ID=k6-contender-caseworker
K6_CONTENDER_CLIENT_SECRET=

# Local Docker Compose defaults. Override both URLs for an ephemeral environment.
K6_API_BASE_URL=http://localhost:8080
K6_OAUTH_TOKEN_URL=http://localhost:9999/entra/token
K6_SERVICE_NAME=CIVIL_APPLY
K6_POLL_TIMEOUT_MS=30000
K6_POLL_INTERVAL_MS=500
K6_SUMMARY_PATH=k6/results/summary.json
K6_CONTENTION_VUS=2
K6_PERFORMANCE_VUS=5
K6_PERFORMANCE_DURATION=5m
# K6_THRESHOLDS=

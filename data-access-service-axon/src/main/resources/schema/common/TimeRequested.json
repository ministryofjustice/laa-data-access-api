{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["hours", "minutes"],
  "properties": {
    "hours": {
      "type": "integer",
      "minimum": 0
    },
    "minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 59
    }
  }
}

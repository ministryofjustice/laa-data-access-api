{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "access.ApplicationUpdated kept fields",
  "description": "Fields kept on the stored event. Every other field is content, stored apart so that it can be erased. Content: content, serialisedRequest.",
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationVersion": {
      "type": "integer"
    },
    "applicationDataVersion": {
      "type": "integer"
    },
    "previousStatus": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "proceedingIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "required": [
    "applicationId",
    "applicationVersion",
    "applicationDataVersion",
    "previousStatus",
    "status",
    "occurredAt",
    "proceedingIds"
  ],
  "additionalProperties": false
}

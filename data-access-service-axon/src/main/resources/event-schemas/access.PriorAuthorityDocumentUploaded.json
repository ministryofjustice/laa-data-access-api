{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "access.PriorAuthorityDocumentUploaded kept fields",
  "description": "Fields kept on the stored event. Every other field is content, stored apart so that it can be erased. Content: contentType, fileSuffix, originalFilename, size, sourceService.",
  "type": "object",
  "properties": {
    "priorAuthorityId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "uploadedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checksum": {
      "type": [
        "string",
        "null"
      ]
    },
    "parentApplicationId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "priorAuthorityId",
    "documentId",
    "uploadedAt",
    "checksum",
    "parentApplicationId"
  ],
  "additionalProperties": false
}

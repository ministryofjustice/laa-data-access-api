{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "access.LinkedApplicationGroupLeadChanged kept fields",
  "description": "Fields kept on the stored event. Every other field is content, stored apart so that it can be erased.",
  "type": "object",
  "properties": {
    "groupId": {
      "type": "string",
      "format": "uuid"
    },
    "previousLeadApplicationId": {
      "type": "string",
      "format": "uuid"
    },
    "newLeadApplicationId": {
      "type": "string",
      "format": "uuid"
    },
    "groupVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "groupId",
    "previousLeadApplicationId",
    "newLeadApplicationId",
    "groupVersion",
    "occurredAt"
  ],
  "additionalProperties": false
}

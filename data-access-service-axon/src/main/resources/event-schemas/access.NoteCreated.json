{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "access.NoteCreated kept fields",
  "description": "Fields kept on the stored event. Every other field is content, stored apart so that it can be erased. Content: noteText.",
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationDataVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "applicationId",
    "applicationDataVersion",
    "occurredAt"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "access.ApplicationDecisionMade kept fields",
  "description": "Fields kept on the stored event. Every other field is content, stored apart so that it can be erased. Content: certificate, eventDescription, meritsDecisions, serialisedRequest.",
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "applicationVersion": {
      "type": "integer"
    },
    "applicationDataVersion": {
      "type": "integer"
    },
    "overallDecision": {
      "type": [
        "string",
        "null"
      ]
    },
    "autoGranted": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PENDING",
        "AUTOGRANTED",
        "MANUAL"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisionRequestFingerprint": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "applicationId",
    "applicationVersion",
    "applicationDataVersion",
    "overallDecision",
    "autoGranted",
    "occurredAt",
    "decisionRequestFingerprint"
  ],
  "additionalProperties": false
}

  "properties": {
    "groupId": {
      "type": "string",
      "format": "uuid"
    },
    "leadApplicationId": {
      "type": "string",
      "format": "uuid"
    },
    "memberApplicationIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "groupId",
    "leadApplicationId",
    "memberApplicationIds",
    "occurredAt"
  ],
  "additionalProperties": false
}

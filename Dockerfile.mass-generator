FROM ghcr.io/ministryofjustice/laa-amazoncorretto:25-jre-alpine

USER root

#update all packages
RUN apk update
RUN apk upgrade

#mount volume
WORKDIR /mass-generator
VOLUME /tmp
COPY data-access-mass-generator/build/libs/data-access-mass-generator-*.jar mass-generator.jar

RUN chown appuser:appgroup mass-generator.jar
USER 1001

ENV TZ=Europe/London
ENV JAVA_TOOL_OPTIONS="-XX:InitialRAMPercentage=50.0 -XX:MaxRAMPercentage=80.0"

CMD ["sleep", "infinity"]
